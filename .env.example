# ===========================================
# CONFIGURACIÓN SUNAT/OSE - BETA/DESARROLLO
# ===========================================
# COPIAR ESTE ARCHIVO A .env Y LLENAR CON TUS CREDENCIALES REALES
# NUNCA COMMITEAR EL ARCHIVO .env CON CREDENCIALES REALES
# ===========================================

# ===========================================
# BASE DE DATOS (No cambiar - Docker maneja esto)
# ===========================================
DATABASE_URL=postgres://dev_user:dev_pass_2026@sunat_db:5432/facturacion_db

# ===========================================
# DJANGO SETTINGS
# ===========================================
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-abc123xyz
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# ===========================================
# SUNAT/OSE - CONFIGURACIÓN MOCK
# ===========================================
# CAMBIAR A False CUANDO TENGAS CREDENCIALES REALES DEL OSE
SUNAT_OSE_MOCK=True

# ===========================================
# SUNAT/OSE - CREDENCIALES REALES (Para producción)
# ===========================================
# URL del WSDL del OSE certificador
# Ejemplos:
#   - SUNAT Beta: https://e-beta.sunat.gob.pe/ol-ti-itcpe/billService
#   - SUMAQ: https://ose.sumaq.pe/billService
#   - Otros OSEs certificados
SUNAT_OSE_WSDL=

# RUC de la empresa emissora (11 dígitos)
SUNAT_OSE_RUC=

# Usuario del OSE (proporcionado por el OSE)
SUNAT_OSE_USUARIO=

# Password del OSE
SUNAT_OSE_PASSWORD=

# ===========================================
# CERTIFICADO DIGITAL (Para firma XML)
# ===========================================
# Ruta al archivo .pfx o .p12 del certificado digital
# En Docker, volumenes montados van en /app/media/certificados/
SUNAT_CERT_PATH=

# Password del certificado digital
SUNAT_CERT_PASSWORD=

# ===========================================
# NOTAS:
# ===========================================
# 1. Mantener SUNAT_OSE_MOCK=True para desarrollo local sin conexion real
# 2. Cuando tengas contrato con OSE certificador, solicitar:
#    - URL del WSDL
#    - Credenciales de acceso
#    - Certificado digital (.pfx)
# 3. El certificado debe estar en formato PKCS#12 (.pfx o .p12)