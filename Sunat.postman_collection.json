					"script": {
						"exec": [
							"// Parse XML response",
							"const responseText = pm.response.text();",
							"",
							"// Extract faultcode",
							"const faultcodeMatch = responseText.match(/<faultcode[^>]*>(.*?)<\\/faultcode>/s);",
							"const faultcode = faultcodeMatch ? faultcodeMatch[1] : 'N/A';",
							"",
							"// Extract faultstring",
							"const faultstringMatch = responseText.match(/<faultstring[^>]*>(.*?)<\\/faultstring>/s);",
							"const faultstring = faultstringMatch ? faultstringMatch[1] : 'N/A';",
							"",
							"// Extract ticket number",
							"const ticketMatch = faultstring.match(/ticket:\\s*(\\d+)/);",
							"const ticket = ticketMatch ? ticketMatch[1] : 'N/A';",
							"",
							"// Extract error type",
							"const errorMatch = faultstring.match(/error:\\s*([^']+)/);",
							"const errorType = errorMatch ? errorMatch[1].trim() : 'N/A';",
							"",
							"// Extract main message (before Detalle)",
							"const mainMessage = faultstring.split(' - Detalle:')[0].trim();",
							"",
							"const template = `",
							"<!DOCTYPE html>",
							"<html>",
