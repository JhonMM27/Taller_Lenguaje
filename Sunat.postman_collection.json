							"    .card { background: white; border-radius: 0 0 8px 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: hidden; }",
							"    .field { display: flex; border-bottom: 1px solid #eee; }",
							"    .field:last-child { border-bottom: none; }",
							"    .label { background: #fdf2f2; color: #c0392b; font-weight: bold; padding: 12px 16px; min-width: 160px; font-size: 13px; }",
							"    .value { padding: 12px 16px; color: #333; font-size: 13px; word-break: break-word; flex: 1; }",
							"    .badge { display: inline-block; background: #c0392b; color: white; border-radius: 4px; padding: 2px 8px; font-size: 12px; }",
							"    .ticket-badge { display: inline-block; background: #2980b9; color: white; border-radius: 4px; padding: 2px 8px; font-size: 12px; }",
							"    .chart-section { padding: 20px; background: white; margin-top: 16px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }",
							"    .chart-title { font-weight: bold; color: #555; margin-bottom: 12px; font-size: 14px; }",
							"    canvas { max-width: 100%; }",
							"  </style>",
							"  <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"><\\/script>",
							"</head>",
							"<body>",
							"  <div class=\"container\">",
							"    <div class=\"header\">",
							"      <h2>&#9888; SOAP Fault Response</h2>",
							"      <div class=\"status\">SUNAT - billService (Beta)</div>",
							"    </div>",
							"    <div class=\"card\">",
							"      <div class=\"field\">",
							"        <div class=\"label\">Fault Code</div>",
							"        <div class=\"value\"><span class=\"badge\">{{faultcode}}</span></div>",
							"      </div>",
							"      <div class=\"field\">",
							"        <div class=\"label\">Message</div>",
							"        <div class=\"value\">{{mainMessage}}</div>",
							"      </div>",
							"      <div class=\"field\">",
							"        <div class=\"label\">Ticket</div>",
							"        <div class=\"value\"><span class=\"ticket-badge\"># {{ticket}}</span></div>",
							"      </div>",
							"      <div class=\"field\">",
							"        <div class=\"label\">Error Type</div>",
							"        <div class=\"value\">{{errorType}}</div>",
							"      </div>",
							"      <div class=\"field\">",
							"        <div class=\"label\">Full Detail</div>",
							"        <div class=\"value\">{{faultstring}}</div>",
							"      </div>",
							"    </div>",
							"    <div class=\"chart-section\">",
							"      <div class=\"chart-title\">Response Status Overview</div>",
							"      <canvas id=\"statusChart\" height=\"120\"></canvas>",
							"    </div>",
							"  </div>",
							"  <script>",
							"    const ctx = document.getElementById('statusChart').getContext('2d');",
							"    new Chart(ctx, {",
							"      type: 'bar',",
							"      data: {",
							"        labels: ['Success', 'Client Error', 'Server Error'],",
							"        datasets: [{",
							"          label: 'Response Count',",
							"          data: [0, 1, 0],",
							"          backgroundColor: ['#27ae60', '#c0392b', '#e67e22'],",
							"          borderRadius: 6",
							"        }]",
							"      },",
							"      options: {",
							"        responsive: true,",
							"        plugins: { legend: { display: false } },",
							"        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }",
							"      }",
							"    });",
							"  <\\/script>",
							"</body>",
							"</html>",
							"`;",
